# ---------------------------------------------------------------------------
# Baxter connection settings. Everything else reads from this one file.
# ---------------------------------------------------------------------------

# Baxter's hostname (mDNS) or IP address. Check the sticker on the robot or
# the boot screen. Rethink defaults look like "011303P0017.local".
# If mDNS never resolves, put the raw IP here instead.
BAXTER_HOSTNAME="Larry.local"

# The wired interface on this laptop that goes to Baxter.
ETH_IFACE="eno2"

# Static IP to give that interface for a direct laptop<->Baxter cable.
# Leave as-is unless Baxter's own address is on a different subnet.
MY_IP="169.254.0.10"
MY_CIDR="16"           # 255.255.0.0

# ROS master port on Baxter. Never change this.
ROS_MASTER_PORT="11311"
